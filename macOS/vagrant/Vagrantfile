# Ruby 3.3.8 bundled with Vagrant can treat refused connections as open on macOS.
if RUBY_VERSION == "3.3.8" && RUBY_PLATFORM.include?("darwin")
  require "socket"

  module Vagrant::Util::IsPortOpen
    def is_port_open?(host, port)
      TCPSocket.new(host, port).close
      true
    rescue Errno::ETIMEDOUT, Errno::ECONNREFUSED, Errno::EHOSTUNREACH,
           Errno::ENETUNREACH, Errno::EACCES, Errno::ENOTCONN, Errno::EALREADY
      false
    end
  end
end

macOSBox = "jhcook/macos-sierra"
windowsBox = "utm/windows-11"

Vagrant.configure("2") do |config|
  config.timezone.value = :host
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "macOS" do |macOS|
    macOS.vm.box = macOSBox

    macOS.vm.provider "virtualbox" do |vb|
      vb.name = "vagrant-macOS"
      vb.memory = "4096"
      vb.customize ["modifyvm", :id, "--vram", "256"]
      vb.customize ["setextradata", :id, "VBoxInternal2/EfiGraphicsResolution", "1920x1080"]
      vb.gui = true
    end
  end

  config.vm.define "windows" do |windows|
    windows.vm.box = windowsBox

    windows.vm.provider "utm" do |u|
      u.name = "vagrant-windows"
      u.memory = "4096"
      u.check_guest_additions = false
    end

    # windows.vm.network "forwarded_port", guest: 8899, host: 8899
    # windows.vm.network "forwarded_port", guest: 8388, host: 8388
  end
end
